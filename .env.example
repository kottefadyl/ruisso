NODE_ENV=development
HOST=127.0.0.1
PORT=3010
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ruissau
DB_USER=root
DB_PASSWORD=
# 1 pour chiffrer la connexion à une base distante (alwaysdata…), 0 en local.
DB_SSL=0
# Connexions simultanées par instance (3 conseillé sur Vercel).
DB_CONNECTION_LIMIT=10
# Les tests (npm test) créent des bases temporaires sur ce serveur local, jamais sur la base distante.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=
# Générés automatiquement par npm run db:init si .env n'existe pas.
SESSION_SECRET=replace-with-at-least-48-random-characters
SETUP_TOKEN=replace-with-at-least-32-random-characters
# Activer seulement derrière un proxy HTTPS de confiance.
TRUST_PROXY=0
